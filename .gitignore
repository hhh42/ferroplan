/target
**/target
*.tmp

# Python bytecode cache (benchmark/harness scripts)
__pycache__/
*.pyc

# local secrets (crates.io token, etc.) — never commit
.env
benchmarks/.val/
benchmarks/.ipc-corpus/

# full-corpus raw per-instance run logs (ipc67.py --raw); summaries are committed
benchmarks/ipc67-*.jsonl
benchmarks/ipc5-*.jsonl
benchmarks/ipc7-*.jsonl
benchmarks/qualpref*.jsonl
benchmarks/ipc201*.jsonl
benchmarks/ipc2023*.jsonl
benchmarks/ipc2026*.jsonl

# ...EXCEPT the two OPTIMAL boards' raws, which are evidence rather than logs:
# on a proof-or-nothing track coverage IS proof rate, and every solved row
# carries a certificate. benchmarks/opt-differential.py replays BOTH of them
# against the current binary (its 0.20 run reproduced 252/252 certified costs),
# so a clone missing one can only referee half the certificates — which is how
# ipc2014-opt.jsonl came to be ignored while its sibling was tracked.
!benchmarks/ipc-opt-2008-11.jsonl
!benchmarks/ipc2014-opt.jsonl

# mdbook build output (generated by `mdbook build` in book/)
book/book/
benchmarks/cut18/
benchmarks/p1-19/
benchmarks/p3-19/
benchmarks/cut19/
benchmarks/cut20/
benchmarks/air/
benchmarks/air21/
# 0.21: the third proof board's raw joins the other two optimal JSONLs as
# tracked evidence — opt-differential.py replays its certificates too.
!benchmarks/ipc2026-opt.jsonl
benchmarks/air-0.18.0/
benchmarks/air-0.19.0/
benchmarks/air22/
benchmarks/air23/
.solver-refs/
benchmarks/air24/
benchmarks/cut24-sweep*.log
benchmarks/cut24/opt-differential.log
benchmarks/air25/
# The three air25-entries files below are read by crucible-publish's compare
# tests as "committed boards" -- they were not, and a fresh worktree failed
# four tests (found 2026-09-04). Evidence comes out of the ignore list.
benchmarks/air25-entries/*
!benchmarks/air25-entries/ipc2014-mco-t2.jsonl
!benchmarks/air25-entries/ipc2018-opt.jsonl
!benchmarks/air25-entries/ipc2018-opt.conditions.json
benchmarks/entries25-sweep.log
benchmarks/post-entries25.log

# crucible: build output, local state, and the regenerable differential ledger.
# The fixtures under crucible/tests/fixtures/ are deliberately NOT ignored --
# they are rescued incident evidence (see that directory's README).
crucible/target/
crucible/state/
benchmarks/crucible-differential.jsonl

# 0.26 referee stages (crucible sets f1-before / f1-armed) and the cut.
benchmarks/air26*/
