+/// The same walk with its preferences on the GOAL only -- the shape the
+/// replay can price whole.
+const GOALPREF: &str = "(define (problem walk-goalpref) (:domain corridor-plain)
+ (:objects c0 c1 c2 c3 s1 - cell)
+ (:init (at c0)
+        (adj c0 c1) (adj c1 c2) (adj c2 c3) (adj c1 s1) (adj s1 c1))
+ (:goal (and (at c3) (preference sidetrip (visited s1)) (preference home (visited c0))))
+ (:metric minimize (+ 2 (* 3 (is-violated home)) (* 5 (is-violated sidetrip)))))";
+
+const CORRIDOR_PLAIN: &str = "(define (domain corridor-plain)
+ (:requirements :strips :typing :preferences)
+ (:types cell)
+ (:predicates (at ?c - cell) (adj ?a ?b - cell) (visited ?c - cell))
+ (:action move :parameters (?a ?b - cell)
+   :precondition (and (at ?a) (adj ?a ?b))
+   :effect (and (not (at ?a)) (at ?b) (visited ?b))))";
+
+fn steps(names: &[&str]) -> Vec<(String, Vec<String>)> {
+    names
+        .iter()
+        .map(|n| {
+            let mut it = n.split_whitespace();
+            (
+                it.next().unwrap().to_string(),
+                it.map(str::to_string).collect(),
+            )
+        })
+        .collect()
+}
+
+/// 0.28 Lane M: when the compiled preference task does not ground inside the
+/// wall or the memory budget, the hard-goal plan is what comes back -- and
+/// its metric is its TRUE metric, by replay over the original pair, not
+/// `None`. Both preferences violated: 2 + 3 + 5. With the side trip: 2 + 3.
+#[test]
+fn a_plan_the_optimizer_never_priced_is_priced_by_replay() {
+    let d = ferroplan::parser::parse_domain(CORRIDOR_PLAIN).unwrap();
+    let p = ferroplan::parser::parse_problem(GOALPREF).unwrap();
+    assert_eq!(pddl3::pure_violation_metric(&p), Some(2.0));
+    let direct = steps(&["MOVE C0 C1", "MOVE C1 C2", "MOVE C2 C3"]);
+    assert_eq!(pddl3::price_by_replay(&d, &p, &direct), Some(10.0));
+    let sidetrip = steps(&[
+        "MOVE C0 C1",
+        "MOVE C1 S1",
+        "MOVE S1 C1",
+        "MOVE C1 C2",
+        "MOVE C2 C3",
+    ]);
+    assert_eq!(pddl3::price_by_replay(&d, &p, &sidetrip), Some(5.0));
+    // A plan that does not reach the hard goal has no price.
+    assert_eq!(pddl3::price_by_replay(&d, &p, &steps(&["MOVE C0 C1"])), None);
+}
+
+/// A wrong metric is worse than none. The replay does not count a
+/// PRECONDITION preference (violated per application), and it does not see
+/// any metric term that is not an `is-violated`: both are refused.
+#[test]
+fn the_replay_refuses_what_it_cannot_price_whole() {
+    let d = ferroplan::parser::parse_domain(CORRIDOR).unwrap();
+    let p = ferroplan::parser::parse_problem(WALK).unwrap();
+    assert_eq!(pddl3::pure_violation_metric(&p), Some(0.0));
+    let direct = steps(&["MOVE C0 C1", "MOVE C1 C2", "MOVE C2 C3"]);
+    assert_eq!(
+        pddl3::price_by_replay(&d, &p, &direct),
+        None,
+        "`darkstep` is a precondition preference: three dark steps would read as none"
+    );
+    let costed = GOALPREF.replace("(+ 2 ", "(+ (total-cost) ");
+    let p = ferroplan::parser::parse_problem(&costed).unwrap();
+    assert_eq!(pddl3::pure_violation_metric(&p), None);
+    let maximized = GOALPREF.replace("minimize", "maximize");
+    let p = ferroplan::parser::parse_problem(&maximized).unwrap();
+    assert_eq!(pddl3::pure_violation_metric(&p), None);
+}
