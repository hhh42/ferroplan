+/// `Some(constant)` iff the metric is a MINIMISED weighted sum of
+/// `(is-violated p)` terms plus a constant -- the one shape whose value the
+/// replay verifier ([`crate::verify`]) computes whole. It does not see
+/// `total-cost`, `(sum-traverse-cost)` or any other fluent term, and a wrong
+/// metric is worse than none: rovers and the metric-preference suites answer
+/// `None` here and stay unpriced.
+pub fn pure_violation_metric(problem: &Problem) -> Option<f64> {
+    let (dir, e) = problem.metric.as_ref()?;
+    if matches!(dir, MetricDir::Maximize) {
+        return None;
+    }
+    let (mut w, mut tc, mut others, mut konst, mut other) =
+        (HashMap::new(), 0.0, HashMap::new(), 0.0, false);
+    extract(e, 1.0, &mut w, &mut tc, &mut others, &mut konst, &mut other);
+    (!other && tc == 0.0 && others.is_empty()).then_some(konst)
+}
+
+/// The true metric of a FINISHED plan, by trajectory replay over the
+/// ORIGINAL pair (0.28 Lane M) -- for the plan the optimizer never got to
+/// price because the compiled preference task did not ground inside the wall
+/// or the memory budget. The original task is the one the hard-goal search
+/// already grounded, a fraction of the compiled one; the replay folds every
+/// preference over a few hundred states. Bounded like any other optional
+/// work on a plan in hand: `None` (the caller reports the plan unpriced, as
+/// before) when the metric has a term the replay cannot see, when the domain
+/// has a precondition preference or the problem a soft trajectory constraint,
+/// when the plan does not replay, or when even this does not fit.
+pub fn price_by_replay(
+    domain: &Domain,
+    problem: &Problem,
+    steps: &[(String, Vec<String>)],
+) -> Option<f64> {
+    let konst = pure_violation_metric(problem)?;
+    // A PRECONDITION preference is violated per application, and the replay
+    // does not count those (grounding reads a positive `Pref` as true). An
+    // optimized plan rarely violates one; a hard-goal plan, which never looked
+    // at them, often does -- and the number would come out too GOOD. tpp.
+    if domain.actions.iter().any(|a| goal_has_pref(&a.precond)) {
+        return None;
+    }
+    // A SOFT TRAJECTORY CONSTRAINT makes the replay as big as what it is
+    // standing in for: `constraints::expand` materialises every instance
+    // again (storage-qualitative i20: 2.3 million), and a "last step" that
+    // took i16 from 4.9 GB to 5.7 and i20 past the cap to 6.2 is not one. Goal
+    // preferences only: one grounding the seed search already fitted, and the
+    // final state.
+    if crate::constraints::has_soft_constraints(domain, problem) {
+        return None;
+    }
+    let _wall = crate::search::reserve_for_report(0);
+    let v = crate::mem::last_step(|| crate::verify::verify_pair(domain, problem, steps)).ok()?;
+    (v.hard_goal_met && v.constraints_met).then_some(v.metric + konst)
+}
