{
  "description": "Manufacture bounded observations and protected actuation intents, preserve exact event frontiers, and require receipt closure before stopping or publishing",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/loop.py\" hook",
            "timeout": 10,
            "statusMessage": "Loading the admitted observation frontier"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/phase.py\" hook",
            "timeout": 10,
            "statusMessage": "Loading the canonical phase snapshot"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/actuation-intent.py\"",
            "timeout": 10,
            "statusMessage": "Manufacturing the protected actuation intent"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/loop.py\" hook",
            "timeout": 10,
            "statusMessage": "Checking the compatibility receipt frontier"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/generated-guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking ontology-generated artifact ownership"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/loop.py\" hook",
            "timeout": 10,
            "statusMessage": "Recording a repository observation candidate"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/loop.py\" hook",
            "timeout": 10,
            "statusMessage": "Recording a failed actuation observation candidate"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/event-summary.py\"",
            "timeout": 10,
            "statusMessage": "Summarizing the bounded tool batch"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/event-summary.py\"",
            "timeout": 10,
            "statusMessage": "Recording Claude configuration drift"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/event-summary.py\"",
            "timeout": 10,
            "statusMessage": "Recording reversible worktree creation"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/event-summary.py\"",
            "timeout": 10,
            "statusMessage": "Recording worktree removal"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/loop.py\" hook",
            "timeout": 10,
            "statusMessage": "Closing the observation-plan-receipt loop"
          }
        ]
      }
    ]
  }
}
