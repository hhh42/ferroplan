{
  "description": "Observe repository mutations, fence protected actuation, and require the Ferroplan receipt frontier before stopping",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/loop.py\" hook",
            "timeout": 10,
            "statusMessage": "Loading Chatman ecosystem standing"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/loop.py\" hook",
            "timeout": 10,
            "statusMessage": "Checking admitted actuation frontier"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/loop.py\" hook",
            "timeout": 10,
            "statusMessage": "Receipting repository observation"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/loop.py\" hook",
            "timeout": 10,
            "statusMessage": "Receipting failed actuation observation"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/loop.py\" hook",
            "timeout": 10,
            "statusMessage": "Closing the observation-plan-receipt loop"
          }
        ]
      }
    ]
  }
}
