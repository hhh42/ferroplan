    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "project": {
      "title": "Project",
      "type": "string"
    },
    "schema": {
      "default": "",
      "title": "Schema",
      "type": "string"
    },
    "stream": {
      "enum": [
        "receipt-frontier",
        "phase-frontier"
      ],
      "title": "Stream",
      "type": "string"
    }
  },
  "required": [
    "stream",
    "project",
    "observed_at_unix_ms"
  ],
  "title": "MonitorTick",
  "type": "object"
}
